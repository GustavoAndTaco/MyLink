rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 루트 문서 (displayName 검색, 기본 프로필 및 소셜 링크 저장)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // 개인화된 링크 목록: users/{userId}/links
      match /links/{linkId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // 개인화된 프로필 서브컬렉션: users/{userId}/profile
      match /profile/{profileId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 그 외 모든 경로 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
